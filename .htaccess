# Настройки для Apache (например, хостинг sweb.ru). На GitHub Pages игнорируется.

# Принудительный HTTPS (рекомендованные SpaceWeb директивы: сайт стоит за прокси,
# реальный схем-детект — по заголовкам X-Forwarded-Proto / HTTPS от фронтового nginx).
RewriteEngine on
SetEnvIf X-Forwarded-Proto https SERVER_PORT=443
SetEnvIf X-Forwarded-Proto https HTTPS=on
RewriteCond %{HTTP:HTTPS} !=on [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

# Страница 404 (сайт в корне домена)
ErrorDocument 404 /404.html

# Закрываем служебные файлы и исходники от прямого доступа
<FilesMatch "^(config\.php|config\.example\.php|build\.py|SEO_PLAN\.md|README\.md|package\.json)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(content|templates|scripts|source-images)(/|$) - [R=404,L]

</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Кэш в браузере (к CSS/JS добавляется ?v=хеш, поэтому после правок всё обновляется само)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>
AddType application/manifest+json .webmanifest

# Безопасные заголовки
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>
